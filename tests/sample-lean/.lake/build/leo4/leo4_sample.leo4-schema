  func pairSndU64U32(_0: Sample.Pair<u64, u32>) -> u32;
  func parseU64(_0: string) -> result<u64, string>;
  func parserId(_0: Sample.ParserHandle) -> Sample.ParserHandle;
  func pointSum(_0: Sample.Point) -> f64;
  func safeDiv(_0: u64, _1: u64) -> option<u64>;
