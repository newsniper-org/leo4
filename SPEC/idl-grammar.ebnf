(* leo4 IDL grammar — strict superset of WIT *)
(* See LEO4-DESIGN.md §4 for prose explanation. *)
(* Productions marked [WIT] are inherited from WIT; productions marked [leo4] *)
(* are leo4-specific extensions that lower to WIT during the lowering pass.   *)

document        = { package_decl | use_decl | interface_decl | world_decl
                  | type_decl | constraint_decl | nominal_decl
                  | mutual_decl | external_decl } ;

package_decl    = "package" , ident , [ ":" , ident ] , [ "@" , semver ] , ";" ;  (* [WIT] *)

use_decl        = "use" , path , [ "as" , ident ] , ";" ;                          (* [WIT] *)

interface_decl  = "interface" , ident , [ generic_params ] , "{" ,
                  { type_decl | func_decl | resource_decl | nominal_decl
                  | mutual_decl | external_decl | use_decl } , "}" ;                (* [leo4] generic_params, nominal_decl, mutual_decl, external_decl *)

world_decl      = "world" , ident , "{" , { world_item } , "}" ;                   (* [WIT] *)
world_item      = "export" , ident , [ "(" , ident , ")" ] , ";"
                | "import" , ident , [ "(" , ident , ")" ] , ";"
                | use_decl | type_decl ;                                            (* [WIT, partial] *)

(* leo4 short-form for nominal declarations introduced in an interface          *)
(* (or top-level): name + body fused into one clause.  The standalone           *)
(* `type X = …` form is the WIT-compatible long form; both are accepted.        *)
(*                                                                              *)
(*   record   Sample.Point<α> { x: α, y: α }                                    *)
(*   enum     Sample.Color { red, green, blue }                                 *)
(*   variant  Sample.Tree { leaf, node(Self, Self) }                            *)
(*   resource Sample.ParserHandle                                               *)
(*   flags    Sample.Perms { read, write, exec }                                *)
nominal_decl    = nominal_record_decl
                | nominal_variant_decl
                | nominal_enum_decl
                | nominal_resource_decl
                | nominal_flags_decl ;                                              (* [leo4] *)
nominal_record_decl    = "record"   , fqn , [ generic_params ] , "{" , field , { "," , field } , "}" , ";" ;
nominal_variant_decl   = "variant"  , fqn , [ generic_params ] , "{" , variant_case , { "," , variant_case } , "}" , ";" ;
nominal_enum_decl      = "enum"     , fqn , [ generic_params ] , "{" , ident , { "," , ident } , "}" , ";" ;
nominal_resource_decl  = "resource" , fqn , [ generic_params ] , [ resource_body ] , ";" ;
nominal_flags_decl     = "flags"    , fqn , [ generic_params ] , "{" , ident , { "," , ident } , "}" , ";" ;

(* Phase 6 — Mutual recursion between nominal types (SPEC/phase-6-mutual.md §1).
   Brackets ≥ 2 nominal decls into one recursion frame. Members reference each
   other via the `Cyc<i>` cycle-breaker token (see `cyc_type` below) instead of
   FQN; the index `i` is 0-based and scoped to the immediately enclosing block.
   A singleton mutual block is a parse error — authors keep using `Self`.       *)
mutual_decl     = "mutual" , "{" , nominal_decl , nominal_decl , { nominal_decl } , "}" , ";" ;  (* [leo4] *)

(* Phase 8 step 2a — types that carry a user-supplied `LeanMarshal`
   instance whose internal fields the plugin cannot lower (proof-carrying
   invariants in Lean core's `Rat`, opaque wrappers, …). Function-position
   references to such a type lower to `IDLType::Record { fqn, args }`
   identically to a regular record — the distinction lives at the
   `UserDecl` level and drives the shim's encode/decode dispatch
   (Lean-emitted C-callable helpers `leo4_marshal_<seg>_dec/_enc`). *)
external_decl   = "external" , fqn , [ generic_params ] , ";" ;                    (* [leo4] *)

generic_params  = "<" , generic_param , { "," , generic_param } , ">" ;            (* [leo4] *)
generic_param   = type_param | value_param ;                                       (* [leo4] *)
type_param      = ident , [ ":" , ( kind | constraint_expr ) ] ;
                                                                                   (* If the `:` annotation is omitted, the param defaults to kind `Type`. *)
value_param     = ident , ":" , type ;                                             (* [leo4] dependent value generic — erased at the boundary *)

(* Kinds (System Fω style; right-associative `->`).                                *)
(* `Type` is the kind of ordinary types; `Type -> Type` is the kind of            *)
(* 1-arity type constructors (HKT); higher arities chain to the right.            *)
(* value_param's annotation is a `type` from §"type" below — e.g. `Nat`, `u32`,    *)
(* `My.Pkg.SomeRecord`. The plugin erases value_params at the boundary; the       *)
(* value never appears in mangled names or wire formats. Real dependent           *)
(* codomain (return type that depends on a value) remains forbidden by             *)
(* LEO4-DESIGN.md §4.3.                                                            *)
kind            = atomic_kind , [ "->" , kind ] ;                                  (* [leo4] *)
atomic_kind     = "Type"
                | "(" , kind , ")" ;

constraint_decl = "constraint" , ident , "=" , constraint_body , ";" ;             (* [leo4] *)
constraint_body = "oneof" , "{" , type , { "," , type } , "}"
                | "trait" , [ trait_body ]
                | constraint_expr ;
trait_body      = "{" , { func_decl } , "}" ;

constraint_expr = constraint_atom , { ( "∧" | "∨" ) , constraint_atom } ;
constraint_atom = "scalar" | "ord" | "eq" | "hash" | "pod" | "marshal" | "resource"
                | ident
                | type , ":" , ident
                | type , "=" , type
                | "¬" , constraint_atom
                | "(" , constraint_expr , ")" ;

type_decl       = "type" , ident , [ generic_params ] , "=" , type , ";" ;         (* [leo4] generic_params *)

func_decl       = "func" , ident , [ generic_params ] , func_sig , ";" ;
func_sig        = "(" , [ param_list ] , ")" , [ "->" , type ] ;
param_list      = param , { "," , param } ;
param           = ident , ":" , type ;

resource_decl   = "resource" , ident , [ generic_params ] , [ resource_body ] , ";" ;
resource_body   = "{" , { func_decl } , "}" ;

type            = primitive | builtin_generic | named_type | record_type
                | variant_type | tuple_type | flag_type | enum_type
                | io_type | self_type | cyc_type | fn_type | owned_type ;         (* [leo4] io_type, self_type, cyc_type, fn_type (Phase 10-B1), owned_type (Phase 10-B1.x reservation) *)

primitive       = "u8" | "u16" | "u32" | "u64"
                | "i8" | "i16" | "i32" | "i64"
                | "f32" | "f64"
                | "bool" | "char" | "string"
                | "bigint" | "bignat" ;                                            (* [leo4] bigint, bignat *)

(* `Self` inside a record_type, variant_type, or resource_decl body refers
   to the enclosing nominal type.
     - `Self` (no args) is syntactic sugar for `Self<…>` with every enclosing
       generic parameter substituted by itself, i.e. the identity instantiation.
     - `Self<T₁,…,Tₙ>` allows substituting a subset of the enclosing generic
       parameters with concrete types (or other in-scope generics). Arity must
       match the enclosing declaration's generic_params arity.
   Permitted only as a type leaf inside the immediately enclosing declaration;
   nested decls reset the binding. Cross-declaration cycles use
   `mutual { … }` + `Cyc<i>` (Phase 6 — SPEC/phase-6-mutual.md). *)
self_type       = "Self" , [ "<" , type , { "," , type } , ">" ] ;                 (* [leo4] *)

(* Phase 6 cycle-breaker. Valid only inside a `mutual_decl` member; the
   resolver rejects `Cyc<i>` outside any mutual block or with `i ≥ group_size`.
   Singleton groups normalise `Cyc<0>` back to `Self` in canonical-form output. *)
cyc_type        = "Cyc" , "<" , unsigned_int , ">" ;                               (* [leo4] *)
unsigned_int    = digit , { digit } ;                                              (* [leo4] zero-or-more decimal digits, no sign *)

(* Phase 10-B1 (2026-05-21): first-class function-arrow type for closures
   crossing the leo4 boundary. Wire form is a single `u64 callback_id`
   (SPEC/canonical-abi.md §13a); mangling is `A_<tuple-of-args>_<ret>_a`
   (SPEC/mangling.md §2). Re-entrant dispatch runtime is per-impl —
   oxilean lands callback runtime as Phase 10-B1.x; mslean4 ships the
   IPC LECQ/LECR frame runtime as a separate sub-phase (SPEC/reverse-
   direction.md §10a). A 0-arg arrow `fn() -> R` is permitted. *)
fn_type         = "fn" , "(" , [ type , { "," , type } ] , ")" , "->" , type ;     (* [leo4] *)

(* Ownership transfer modifier (Phase 10-B1.x reservation, 2026-05-28).
   Without `own<…>` a `resource` argument is borrowed — callee MUST NOT
   retain the handle past the enclosing call. With `own<R>` ownership
   transfers and the callee owns `dec_rc` (or the impl-equivalent). The
   modifier may also wrap a `fn_type` (`own<fn(…) -> R>`) to mark a
   transferable closure, also reserved-but-unspecified at v0.
   Wire form: identical to the underlying type — `own<…>` is a typed
   marker on top of the regular encoding, not an extra frame. Mangling
   rotates the schema hash (`w_<mangle(T)>_w`) so a borrow→own change in
   a published interface forces consumers to re-handshake. *)
owned_type      = "own" , "<" , type , ">" ;                                       (* [leo4] *)

builtin_generic = "list" , "<" , type , ">"
                | "option" , "<" , type , ">"
                | "result" , "<" , type , [ "," , type ] , ">"
                | "tuple" , "<" , type , { "," , type } , ">"
                | "future" , "<" , type , ">"                                      (* [WIT; LEO4-DESIGN.md D4 (lifted 2026-05-20). Lowers to a function-level `FuncDecl.effect = Async` flag, NOT an IDLType variant — only valid at the boundary position of a `func_decl`'s return type, not inside records / variants. ] *)
                | "stream" , "<" , type , ">" ;                                    (* [WIT; same lifting decision as `future<T>` above — `FuncDecl.effect = Stream`. ] *)

named_type      = ident , [ "<" , type , { "," , type } , ">" ] ;                  (* [leo4] generic application *)

record_type     = "record" , [ fqn ] , [ generic_params ] ,
                  "{" , field , { "," , field } , "}" ;
field           = ident , ":" , type ;

variant_type    = "variant" , [ fqn ] , [ generic_params ] ,
                  "{" , variant_case , { "," , variant_case } , "}" ;
variant_case    = ident , [ "(" , type , { "," , type } , ")" ] ;

(* Fully-qualified name: module path + base name, joined by `.` in IDL text.
   Used to disambiguate `Sample.Point` from `Other.Point`.  In mangled
   names the `.` separators are replaced with `_` (see SPEC/mangling.md §2). *)
fqn             = ident , { "." , ident } ;

tuple_type      = "tuple" , "<" , type , { "," , type } , ">" ;
flag_type       = "flags" , [ ident ] , "{" , ident , { "," , ident } , "}" ;
enum_type       = "enum" , [ ident ] , "{" , ident , { "," , ident } , "}" ;

io_type         = "io" , "<" , type , ">" ;                                        (* [leo4] *)

(* lowercase identifiers, kebab-case allowed *)
ident           = letter , { letter | digit | "-" | "_" } ;
letter          = "a"..."z" | "A"..."Z" ;
digit           = "0"..."9" ;
path            = ident , { ":" , ident } , [ "/" , ident ] ;
semver          = digit , { digit } , "." , digit , { digit } , "." , digit , { digit } ;
